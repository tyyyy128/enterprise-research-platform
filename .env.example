# Safe local defaults. Copy only if appropriate for your DeerFlow extension runtime.
# Never commit real credentials or database passwords.

ENTERPRISE_RESEARCH_REPOSITORY=memory
ENTERPRISE_RESEARCH_PLANNER_BACKEND=disabled
ENTERPRISE_RESEARCH_SEARCH_BACKEND=disabled
ENTERPRISE_RESEARCH_CLAIM_BACKEND=disabled
ENTERPRISE_RESEARCH_CLAIM_VERIFICATION_BACKEND=disabled
ENTERPRISE_RESEARCH_WRITER_BACKEND=disabled

# Enable paid providers only after configuration and budget review:
# ENTERPRISE_RESEARCH_PLANNER_BACKEND=openai-compatible
# ENTERPRISE_RESEARCH_PLANNER_BASE_URL=
# ENTERPRISE_RESEARCH_PLANNER_MODEL=
# ENTERPRISE_RESEARCH_PLANNER_API_KEY=
# ENTERPRISE_RESEARCH_SEARCH_BACKEND=tavily
# TAVILY_API_KEY=

# For strict annual-report evidence workflows only:
# ENTERPRISE_RESEARCH_EVIDENCE_SELECTION_MODE=financial_precision
# ENTERPRISE_RESEARCH_EVIDENCE_FOCUS_TERMS=FY2024,Total revenue
# ENTERPRISE_RESEARCH_EVIDENCE_PREFERRED_DOMAINS=microsoft.com
